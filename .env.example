# App
# APP_ENV: which environment is this? Affects config choices (mail driver, session, etc.)
#   Values: development | testing | production
APP_ENV=development
# APP_DEBUG: show detailed errors and stack traces in the browser?
#   Values: true | false — always set to false in production
APP_DEBUG=true
APP_URL=http://localhost/myproject
APP_DOMAIN=localhost

# Database
DB_HOST=localhost
DB_NAME=myproject_db
DB_USER=root
DB_PASS=

# Email (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_PORT=465

# Session
SESSION_LIFETIME=10800
SESSION_SECURE=false
