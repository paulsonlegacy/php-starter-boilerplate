{
    "name": "paulson/php-starter-boilerplate",
    "description": "A lightweight, functional (non-OOP) PHP MVC boilerplate with Composer, .env, PHPUnit, and route-based controllers",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "vlucas/phpdotenv": "^5.6",
        "phpmailer/phpmailer": "^6.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "files": [
            "app/connect.php",
            "app/functions.php"
        ]
    },
    "scripts": {
        "test": "phpunit",
        "migrate": "php app/migrate.php"
    }
}
